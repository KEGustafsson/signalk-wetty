{
  "name": "signalk-wetty",
  "version": "0.1.0",
  "description": "Embedded WeTTY web terminal for the Signal K server admin UI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "KEGustafsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KEGustafsson/signalk-wetty.git"
  },
  "bugs": {
    "url": "https://github.com/KEGustafsson/signalk-wetty/issues"
  },
  "homepage": "https://github.com/KEGustafsson/signalk-wetty#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-embeddable-webapp",
    "signalk-category-utility",
    "wetty",
    "terminal",
    "ssh",
    "xterm"
  ],
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "appIcon": "./app-icon.svg",
    "displayName": "WeTTY Terminal",
    "screenshots": [
      "./public/screenshot-terminal.svg",
      "./public/screenshot-config.svg"
    ]
  },
  "files": [
    "dist/",
    "native-prebuilds/",
    "public/",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:webapp",
    "build:webapp": "webpack --config webpack.config.js",
    "build:node-pty-prebuild": "node scripts/build-node-pty-prebuild.mjs",
    "clean": "rimraf dist public/*.js public/*.js.map public/*.LICENSE.txt",
    "prepack": "npm run build",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test": "npm run build && node --test",
    "test:only": "node --test",
    "coverage": "npm run build && node --test --experimental-test-coverage",
    "integration": "node integration/signalk-smoke.mjs"
  },
  "optionalDependencies": {
    "wetty": "^3.2.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "eslint": "^9.19.0",
    "globals": "^17.8.0",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "http-proxy-middleware": "^3.0.7"
  }
}
